# The briefing is reached by link only: no card, no nav entry, and no
# search engine. The page carries a noindex meta as well; this covers
# crawlers that read headers before markup.
/briefing
  X-Robots-Tag: noindex, nofollow
/briefing.html
  X-Robots-Tag: noindex, nofollow

# The avatar app (PWA) is personal and reached by link only. The service
# worker must never be served stale, or an old version pins itself.
/avatar/*
  X-Robots-Tag: noindex, nofollow
/avatar/sw.js
  Cache-Control: no-cache
